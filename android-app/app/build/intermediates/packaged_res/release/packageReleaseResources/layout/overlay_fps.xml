<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/overlay_bg"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/fps_value"
            android:text="-- fps"
            android:textColor="@color/pb_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/fps_pkg"
            android:text=""
            android:textColor="@color/pb_dim"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="middle"
            android:maxWidth="150dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/overlay_close"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/close_overlay"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:layout_marginStart="6dp"
        android:layout_width="32dp"
        android:layout_height="32dp" />

</LinearLayout>
