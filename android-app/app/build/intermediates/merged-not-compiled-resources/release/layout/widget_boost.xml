<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_title"
        android:text="@string/app_name_caps"
        android:textColor="@color/pb_dim"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.22"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/widget_ram"
        android:text="FREE -- · USED --%"
        android:textColor="@color/pb_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/widget_hint"
        android:text="updates every 30 s"
        android:textColor="@color/pb_dim"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/widget_boost_button"
        android:text="@string/widget_boost"
        android:textColor="@color/pb_bg"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:backgroundTint="@color/pb_accent"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="36dp" />

</LinearLayout>
